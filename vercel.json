{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.go",
      "use": "@vercel/go"
    }
  ],
  "routes": [
    {
      "src": "backend/api/(.*)",
      "dest": "/api/index.go"
    },
    {
      "src": "backend/(.*)",
      "dest": "backend/api/index.go"
    }
  ],
  "env": {
    "GO_ENV": "production"
  }
}
